# Place secrets in `.env.local` (never commit).

# --- Local db:push / db:seed against Vercel Neon ---
# One-time: npx vercel link --yes --scope <team> --project edgehealthcare
# Then: npm run db:pull-env
# If Postgres lines are still empty, paste POSTGRES_* / DATABASE_* from Vercel → Storage → your DB.

# Neon / Vercel Postgres — pooled URL for the app (Vercel may also expose DATABASE_URL)
POSTGRES_URL=
DATABASE_URL=

# Direct / non-pooling URL for `drizzle-kit` / migrations (preferred for db:push)
POSTGRES_URL_NON_POOLING=
DATABASE_URL_UNPOOLED=

# Auth.js — generate: `openssl rand -base64 32`
AUTH_SECRET=

# Canonical site URL for Auth.js callbacks (e.g. http://localhost:3000 or Vercel URL)
AUTH_URL=http://localhost:3000

# Simulator + Edge ingest (any long random string)
INGEST_API_KEY=

# Dashboard "Simulate vitals" toggle → POST /api/demo/simulate-tick (use 1 or true for demo only)
ENABLE_DEMO_SIMULATOR=

# Optional Vercel Cron (Authorization: Bearer ...)
CRON_SECRET=

# After `npm run db:seed`, copy printed UUID:
SIMULATE_USER_ID=
