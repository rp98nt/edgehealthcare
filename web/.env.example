# Place secrets in `.env.local` (never commit).

# Neon / Vercel Postgres — pooled URL for the app (Vercel may also expose DATABASE_URL)
POSTGRES_URL=
DATABASE_URL=

# Direct / non-pooling URL for `drizzle-kit migrate` (optional if you use `db:push`)
POSTGRES_URL_NON_POOLING=

# Auth.js — generate: `openssl rand -base64 32`
AUTH_SECRET=

# Canonical site URL for Auth.js callbacks (e.g. http://localhost:3000 or Vercel URL)
AUTH_URL=http://localhost:3000

# Simulator + Edge ingest (any long random string)
INGEST_API_KEY=

# Optional Vercel Cron (Authorization: Bearer ...)
CRON_SECRET=

# After `npm run db:seed`, copy printed UUID:
SIMULATE_USER_ID=
